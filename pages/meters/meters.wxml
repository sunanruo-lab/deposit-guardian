<view class="page"><view class="hero"><view class="title">水电燃气表</view><view class="subtitle">同时保留入住与退租读数；差值只用于记录，不代表官方账单。</view></view><view wx:for="{{rows}}" wx:key="name" class="card"><view class="card-title">{{item.name}}</view><view class="compare"><view><text class="muted">入住</text><view class="reading">{{item.a?item.a.reading:'未记录'}} {{item.a?item.a.unit:''}}</view><image wx:if="{{item.a.photo}}" class="thumb" src="{{item.a.photo.path}}" mode="aspectFill" bindtap="preview" data-path="{{item.a.photo.path}}"/><button wx:if="{{item.a}}" class="mini" bindtap="del" data-id="{{item.a.id}}">删除</button></view><view><text class="muted">退租</text><view class="reading">{{item.b?item.b.reading:'未记录'}} {{item.b?item.b.unit:''}}</view><image wx:if="{{item.b.photo}}" class="thumb" src="{{item.b.photo.path}}" mode="aspectFill" bindtap="preview" data-path="{{item.b.photo.path}}"/><button wx:if="{{item.b}}" class="mini" bindtap="del" data-id="{{item.b.id}}">删除</button></view></view><view class="diff">差值：{{item.diff===null?'待完整记录':item.diff}}</view></view><button class="btn" bindtap="add">＋ 添加表计读数</button><app-disclaimer/></view>
