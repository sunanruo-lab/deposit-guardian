.compare{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.compare>view{background:#F7F3EA;border-radius:16rpx;padding:20rpx}.reading{font-size:31rpx;font-weight:800;margin:10rpx 0}.thumb{width:100%;height:150rpx;border-radius:12rpx}.diff{margin-top:16rpx;padding:14rpx;background:#EDF3EF;color:#244A3D;border-radius:12rpx}.mini{font-size:20rpx;background:none;color:#C85C54;margin:8rpx 0 0;padding:0}.mini::after{border:0}
