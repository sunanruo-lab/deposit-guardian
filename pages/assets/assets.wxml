<view class="page"><view class="hero"><view class="title">家具家电清单</view><view class="subtitle">记录归属、外观与功能测试结果。</view></view><view class="card" wx:for="{{items}}" wx:key="id"><view class="between"><view class="card-title">{{item.name}} × {{item.quantity}}</view><text class="tag">{{item.status}}</text></view><view>{{item.room}} · {{item.brand||'品牌未填'}} {{item.model}}</view><view class="muted">{{item.landlordOwned?'房东物品':'租客物品'}} · {{item.testResult}}</view><view class="photo-grid"><image class="photo" wx:for="{{item.photos}}" wx:key="id" src="{{item.path}}" mode="aspectFill"/></view><button class="btn secondary small" data-id="{{item.id}}" bindtap="edit">编辑</button><button class="btn danger small" data-id="{{item.id}}" bindtap="del">删除</button></view><view class="card" wx:if="{{show}}"><view class="card-title">{{d.id?'编辑':'新增'}}物品</view><view class="label">常用模板</view><picker range="{{templates}}" value="{{templateIndex}}" bindchange="pickName"><view class="picker">{{d.name}}</view></picker><view class="grid"><view><view class="label">名称</view><input class="input" data-k="name" value="{{d.name}}" bindinput="set"/></view><view><view class="label">所属房间</view><input class="input" data-k="room" value="{{d.room}}" bindinput="set"/></view><view><view class="label">品牌</view><input class="input" data-k="brand" value="{{d.brand}}" bindinput="set"/></view><view><view class="label">型号</view><input class="input" data-k="model" value="{{d.model}}" bindinput="set"/></view><view><view class="label">数量</view><input class="input" type="number" data-k="quantity" value="{{d.quantity}}" bindinput="set"/></view><view><view class="label">当前状态</view><picker range="{{statuses}}" value="{{statusIndex}}" bindchange="pickStatus"><view class="picker">{{d.status}}</view></picker></view></view><view class="label">功能测试结果</view><input class="input" data-k="testResult" value="{{d.testResult}}" bindinput="set"/><view class="label">问题说明</view><textarea class="textarea" data-k="note" value="{{d.note}}" bindinput="set"/><view class="between"><text>属于房东物品</text><switch color="#3F826D" checked="{{d.landlordOwned}}" bindchange="owned"/></view><view class="photo-grid"><view class="photo-wrap" wx:for="{{d.photos}}" wx:key="id"><image class="photo" src="{{item.path}}" mode="aspectFill"/><text class="photo-del" data-i="{{index}}" bindtap="delPhoto">×</text></view></view><button class="btn secondary" bindtap="photos">添加外观照片</button><button class="btn" bindtap="save">保存物品</button></view><button wx:if="{{!show}}" class="btn" bindtap="add">＋ 添加家具家电</button><app-disclaimer/></view>
