<view class="page">
  <view class="card" wx:if="{{phase==='退租'&&original}}">
    <view class="card-title">入住原始记录</view>
    <view class="between">
      <text class="tag">{{original.status}}</text>
      <text class="muted">{{original.note || '无说明'}}</text>
    </view>
    <view class="photo-grid">
      <image wx:for="{{original.photos}}" wx:key="id" class="photo" src="{{item.path}}" mode="aspectFill" bindtap="preview" data-path="{{item.path}}" />
    </view>
  </view>

  <view class="card">
    <view class="between">
      <view class="card-title">{{itemName}}</view>
      <text class="tag">{{phase}}</text>
    </view>

    <view class="label">状态</view>
    <picker range="{{statuses}}" value="{{statusIndex}}" bindchange="status">
      <view class="picker">{{record.status}}</view>
    </picker>

    <view class="label">严重程度</view>
    <picker range="{{severities}}" value="{{severityIndex}}" bindchange="severity">
      <view class="picker">{{record.severity}}</view>
    </picker>

    <view wx:if="{{phase==='退租'}}">
      <view class="label">与入住相比</view>
      <picker range="{{comparisons}}" value="{{comparisonIndex}}" bindchange="comparison">
        <view class="picker">{{record.comparison}}</view>
      </picker>
    </view>

    <view class="label">问题说明</view>
    <view class="field-control multi {{record.note ? '' : 'placeholder'}}" bindtap="editNote">
      {{record.note || '点击填写位置、大小、是否影响使用等'}}
    </view>

    <view class="label">现场照片（可多选）</view>
    <view class="photo-grid">
      <view wx:for="{{record.photos}}" wx:key="id" class="photo-wrap">
        <image class="photo" src="{{item.path}}" mode="aspectFill" bindtap="preview" data-path="{{item.path}}" />
        <text class="photo-del" bindtap="delPhoto" data-i="{{index}}">×</text>
      </view>
    </view>
    <button class="btn secondary" bindtap="photos">拍照或从相册选择</button>
  </view>

  <button class="btn" bindtap="save">保存检查记录</button>
  <button class="btn danger" wx:if="{{record.status!=='尚未检查'}}" bindtap="del">删除记录</button>
  <app-disclaimer></app-disclaimer>
</view>
