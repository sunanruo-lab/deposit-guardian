<view class="page" wx:if="{{p}}"><view class="hero"><view class="between"><view><view class="title">{{p.name}}</view><view class="subtitle">{{p.address}}</view></view><text class="tag">{{p.stage}}</text></view><button class="btn hero-btn" bindtap="edit">编辑基础信息</button></view><view class="card"><view class="card-title">检查进度</view><view class="between"><text>入住 {{inProg.done}}/{{inProg.total}}</text><text>{{inProg.pct}}%</text></view><view class="progress"><view class="progress-in" style="width:{{inProg.pct}}%"></view></view><view class="between mt"><text>退租 {{outProg.done}}/{{outProg.total}}</text><text>{{outProg.pct}}%</text></view><view class="progress"><view class="progress-in orange" style="width:{{outProg.pct}}%"></view></view></view><view class="card"><view class="card-title">档案工作台</view><view class="grid"><button class="entry" data-path="inspection" bindtap="go">📋 入住检查</button><button class="entry" data-path="moveout" bindtap="go">🔍 退租检查</button><button class="entry" data-path="meters" bindtap="go">⚡ 水电燃气</button><button class="entry" data-path="keys" bindtap="go">🔑 钥匙门禁</button><button class="entry" data-path="assets" bindtap="go">🛋 家具家电</button><button class="entry" data-path="issues" bindtap="go">🏷 问题档案</button><button class="entry" data-path="confirm" bindtap="go">✍️ 交接确认</button><button class="entry" data-path="reports" bindtap="go">🧾 生成报告</button></view></view><app-disclaimer/></view>
