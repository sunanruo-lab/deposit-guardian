<view class="page">
  <view class="hero">
    <view class="title">交接确认</view>
    <view class="subtitle">双方可在同一台手机上填写并签署。</view>
  </view>

  <view class="card">
    <view class="grid">
      <view>
        <view class="label">租客姓名 *</view>
        <view class="field-control {{c.tenantName ? '' : 'placeholder'}}" data-k="tenantName" bindtap="editField">
          {{c.tenantName || '点击填写租客姓名'}}
        </view>
      </view>
      <view>
        <view class="label">房东/中介姓名 *</view>
        <view class="field-control {{c.landlordName ? '' : 'placeholder'}}" data-k="landlordName" bindtap="editField">
          {{c.landlordName || '点击填写房东/中介姓名'}}
        </view>
      </view>
      <view>
        <view class="label">租客联系方式</view>
        <view class="field-control {{c.tenantContact ? '' : 'placeholder'}}" data-k="tenantContact" bindtap="editField">
          {{c.tenantContact || '点击填写联系方式'}}
        </view>
      </view>
      <view>
        <view class="label">房东/中介联系方式</view>
        <view class="field-control {{c.landlordContact ? '' : 'placeholder'}}" data-k="landlordContact" bindtap="editField">
          {{c.landlordContact || '点击填写联系方式'}}
        </view>
      </view>
    </view>

    <view class="label">交接日期 *</view>
    <picker mode="date" data-k="date" value="{{c.date}}" bindchange="set">
      <view class="picker">{{c.date || '选择日期'}}</view>
    </picker>

    <view class="label">双方补充说明</view>
    <view class="field-control multi {{c.note ? '' : 'placeholder'}}" data-k="note" bindtap="editField">
      {{c.note || '点击填写补充说明'}}
    </view>
  </view>

  <view class="card">
    <view class="card-title">手写签名</view>
    <view class="grid">
      <view>
        <view class="muted">租客签名</view>
        <image wx:if="{{c.tenantSignature}}" class="signature" src="{{c.tenantSignature}}" mode="aspectFit" />
        <button class="btn secondary small" data-who="tenant" bindtap="startSign">{{c.tenantSignature ? '重新签署' : '开始签署'}}</button>
      </view>
      <view>
        <view class="muted">房东/中介签名</view>
        <image wx:if="{{c.landlordSignature}}" class="signature" src="{{c.landlordSignature}}" mode="aspectFit" />
        <button class="btn secondary small" data-who="landlord" bindtap="startSign">{{c.landlordSignature ? '重新签署' : '开始签署'}}</button>
      </view>
    </view>
    <view class="notice">签名仅用于记录双方当时的确认情况，本工具不对其法律效力作出保证。</view>
  </view>

  <button class="btn" bindtap="save">保存交接确认</button>
  <app-disclaimer></app-disclaimer>

  <view class="mask" wx:if="{{signing}}">
    <view class="sign-box">
      <view class="between"><view class="card-title">请在下方签名</view><text bindtap="cancel">关闭</text></view>
      <canvas canvas-id="signCanvas" class="canvas" disable-scroll="true" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd"></canvas>
      <view class="between">
        <button class="btn secondary small" bindtap="clear">清除</button>
        <button class="btn small" bindtap="finish">保存签名</button>
      </view>
    </view>
  </view>
</view>
