.signature{width:100%;height:130rpx;background:#F7F3EA;border-radius:12rpx}.notice{margin-top:24rpx;padding:20rpx;background:#FFF0E1;color:#8A5525;border-radius:16rpx;font-size:23rpx}.mask{position:fixed;inset:0;background:rgba(0,0,0,.55);display:flex;align-items:flex-end;z-index:50}.sign-box{background:#fff;width:100%;padding:30rpx;border-radius:30rpx 30rpx 0 0}.canvas{width:700rpx;height:300rpx;background:#F7F3EA;border:1rpx dashed #7A817D;border-radius:16rpx}
