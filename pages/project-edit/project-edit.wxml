<view class="page">
  <form bindsubmit="save">
    <view class="card">
      <view class="card-title">基础信息</view>

      <view class="label">项目名称 *</view>
      <input
        class="input"
        name="name"
        value="{{p.name}}"
        bindinput="onNameInput"
        cursor-spacing="80"
        adjust-position="true"
        placeholder="例如：上海静安一居室"
      />

      <view class="label">房屋地址 *</view>
      <textarea
        class="textarea"
        name="address"
        value="{{p.address}}"
        bindinput="onAddressInput"
        cursor-spacing="80"
        adjust-position="true"
        placeholder="填写详细地址"
      />

      <view class="grid">
        <view>
          <view class="label">租客姓名 *</view>
          <input
            class="input"
            name="tenant"
            value="{{p.tenant}}"
            bindinput="onTenantInput"
            cursor-spacing="80"
            adjust-position="true"
            placeholder="例如：张三"
          />
        </view>
        <view>
          <view class="label">房东/中介称呼</view>
          <input
            class="input"
            name="landlord"
            value="{{p.landlord}}"
            bindinput="onLandlordInput"
            cursor-spacing="80"
            adjust-position="true"
            placeholder="例如：李房东"
          />
        </view>
      </view>

      <view class="grid">
        <view>
          <view class="label">租赁开始 *</view>
          <picker mode="date" value="{{p.startDate}}" data-key="startDate" bindchange="onDateChange">
            <view class="picker">{{p.startDate || '选择日期'}}</view>
          </picker>
        </view>
        <view>
          <view class="label">租赁结束 *</view>
          <picker mode="date" value="{{p.endDate}}" data-key="endDate" bindchange="onDateChange">
            <view class="picker">{{p.endDate || '选择日期'}}</view>
          </picker>
        </view>
      </view>

      <view class="grid">
        <view>
          <view class="label">月租金额（元）</view>
          <input
            class="input"
            type="digit"
            name="rent"
            value="{{p.rent}}"
            bindinput="onRentInput"
            cursor-spacing="80"
            adjust-position="true"
            placeholder="例如：3500"
          />
        </view>
        <view>
          <view class="label">押金金额（元）</view>
          <input
            class="input"
            type="digit"
            name="deposit"
            value="{{p.deposit}}"
            bindinput="onDepositInput"
            cursor-spacing="80"
            adjust-position="true"
            placeholder="例如：3500"
          />
        </view>
      </view>

      <view class="label">当前阶段</view>
      <picker range="{{stages}}" value="{{stageIndex}}" bindchange="onStageChange">
        <view class="picker">{{p.stage}}</view>
      </picker>

      <view class="label">补充备注</view>
      <textarea
        class="textarea"
        name="note"
        value="{{p.note}}"
        bindinput="onNoteInput"
        cursor-spacing="80"
        adjust-position="true"
        placeholder="可记录合同编号、特殊约定等"
      />
    </view>

    <button class="btn" form-type="submit">保存房屋档案</button>
  </form>

  <button wx:if="{{editing}}" class="btn danger" bindtap="del">删除房屋档案</button>
  <app-disclaimer></app-disclaimer>
</view>
