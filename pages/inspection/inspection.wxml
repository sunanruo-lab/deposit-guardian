<view class="page"><view class="hero"><view class="title">{{phase}}检查清单</view><view class="subtitle">逐项记录状态和现场照片，记录会自动保存在本机。</view></view><view wx:for="{{rooms}}" wx:key="id" class="card"><view class="between"><view><view class="card-title">{{item.name}}</view><view class="muted">{{item.done}} / {{item.items.length}} 已完成</view></view><view><button class="icon-btn" data-id="{{item.id}}" bindtap="rename">改名</button><button class="icon-btn" data-id="{{item.id}}" bindtap="delRoom">删除</button></view></view><view class="progress"><view class="progress-in" style="width:{{item.pct}}%"></view></view><view class="items"><view wx:for="{{item.items}}" wx:for-item="check" wx:key="*this" class="check-row" bindtap="open" data-room="{{item.id}}" data-item="{{check}}"><text>{{check}}</text><text class="muted">填写 ›</text></view></view><button class="btn secondary small" data-id="{{item.id}}" bindtap="addItem">＋ 自定义检查项</button></view><button class="btn" bindtap="addRoom">＋ 新增自定义房间</button><app-disclaimer/></view>
