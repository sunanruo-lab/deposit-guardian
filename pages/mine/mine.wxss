.stats{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.stats view{background:#F7F3EA;border-radius:18rpx;padding:22rpx;text-align:center}.stats .num{display:block;font-size:48rpx;color:#244A3D;font-weight:800}.stats text{font-size:22rpx;color:#7A817D}.menu{width:100%;height:86rpx;background:none;border:0;border-bottom:1rpx solid #EEEAE2;display:flex;align-items:center;justify-content:space-between;text-align:left;font-size:27rpx;padding:0}.menu::after{border:0}.menu text{color:#7A817D;font-size:22rpx}.danger-text{color:#C85C54}
