<view class="page"><view class="hero"><view class="title">生成交接报告</view><view class="subtitle">高清长图会自动分页，每页包含项目名、页码和生成日期。</view></view><view class="card"><view class="label">报告类型</view><picker range="{{types}}" value="{{typeIndex}}" bindchange="pick"><view class="picker">{{types[typeIndex]}}</view></picker><button class="btn" loading="{{generating}}" disabled="{{generating}}" bindtap="generate">{{generating?progress:'生成高清报告'}}</button></view><view class="card" wx:for="{{reports}}" wx:key="id"><view class="between"><view><view class="card-title">{{item.type}}</view><view class="muted">{{item.date}} · {{item.paths.length}} 页</view></view><text class="stamp">已归档</text></view><button class="btn secondary small" bindtap="preview" data-id="{{item.id}}">预览</button><button class="btn small" bindtap="saveAlbum" data-id="{{item.id}}">保存到相册</button><button class="btn danger small" bindtap="del" data-id="{{item.id}}">删除</button></view><view class="card empty" wx:if="{{!reports.length}}"><view class="empty-icon">🧾</view><view>还没有生成过报告</view></view><canvas canvas-id="reportCanvas" class="report-canvas"></canvas><app-disclaimer/></view>
