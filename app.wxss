page{background:#F7F3EA;color:#252A28;font-size:28rpx;box-sizing:border-box}view,text,input,textarea,button,picker,scroll-view{box-sizing:border-box}.page{padding:28rpx 28rpx 60rpx}.hero{background:#244A3D;color:#fff;border-radius:28rpx;padding:36rpx;box-shadow:0 14rpx 34rpx rgba(36,74,61,.18)}.title{font-size:42rpx;font-weight:800}.subtitle{font-size:25rpx;opacity:.82;margin-top:10rpx}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-top:22rpx;box-shadow:0 8rpx 24rpx rgba(37,42,40,.06);border:1rpx solid rgba(36,74,61,.06)}.card-title{font-size:31rpx;font-weight:700;margin-bottom:18rpx}.btn{height:88rpx;line-height:88rpx;border-radius:20rpx;background:#244A3D;color:#fff;font-size:29rpx;font-weight:700;margin:18rpx 0 0}.btn::after{border:0}.btn.secondary{background:#E8EFEA;color:#244A3D}.btn.orange{background:#E89A52}.btn.danger{background:#C85C54}.btn.small{display:inline-block;height:62rpx;line-height:62rpx;font-size:24rpx;margin:8rpx 10rpx 0 0;padding:0 24rpx}.label{font-size:24rpx;color:#7A817D;margin:20rpx 0 10rpx}.input,.textarea,.picker{width:100%;background:#F7F3EA;border-radius:16rpx;padding:22rpx;border:1rpx solid #E5E1D8}.textarea{min-height:150rpx}.field-control{position:relative;z-index:1;min-height:88rpx;line-height:44rpx;width:100%;background:#F7F3EA;border-radius:16rpx;padding:22rpx;border:1rpx solid #E5E1D8;color:#252A28;font-size:28rpx;word-break:break-all}.field-control.multi{min-height:140rpx;line-height:42rpx}.field-control.placeholder{color:#9EA49F}.row{display:flex;align-items:center;gap:18rpx}.between{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.tag{display:inline-block;border-radius:999rpx;padding:8rpx 16rpx;background:#E8EFEA;color:#3F826D;font-size:22rpx}.tag.warn{background:#FFF0E1;color:#B86721}.tag.risk{background:#FBE7E5;color:#C85C54}.muted{color:#7A817D;font-size:24rpx}.empty{text-align:center;padding:70rpx 30rpx;color:#7A817D}.empty-icon{font-size:76rpx;margin-bottom:18rpx}.divider{height:1rpx;background:#ECE8DE;margin:22rpx 0}.progress{height:12rpx;background:#E7EAE7;border-radius:99rpx;overflow:hidden}.progress-in{height:100%;background:#3F826D}.photo-grid{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:14rpx}.photo{width:148rpx;height:148rpx;border-radius:14rpx;object-fit:cover}.photo-wrap{position:relative}.photo-del{position:absolute;right:-8rpx;top:-8rpx;width:38rpx;height:38rpx;border-radius:50%;background:#C85C54;color:#fff;text-align:center;line-height:38rpx}.section-label{font-weight:700;color:#244A3D;margin:28rpx 0 6rpx}.safe-bottom{padding-bottom:40rpx}
